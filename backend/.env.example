SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server only; used to revoke an invitation when email delivery fails.
SUPABASE_SECRET_KEY=replace-with-secret-key
FRONTEND_URL=http://localhost:5173
PORT=5000

# Optional until email invitations are enabled. Use your email provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional AI description suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
